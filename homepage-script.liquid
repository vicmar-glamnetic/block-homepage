{%- comment -%}
  Geo gate — BLOCKLIST mode.

  Visitors from the listed countries ('PK', 'EG', 'MA', 'IL', 'LB', 'YE', 'OM', 'IN', 'GB') see the ADJUSTED homepage (#MaintenanceHome). Every other country sees the store as usual. All non-homepage templates always render normally for everyone.

  Country is resolved by querying ALL keyless geo providers IN PARALLEL
  (country.is, geojs, ipapi, ipwho.is); the first valid answer wins, so a slow or
  rate-limited provider can't hold up the verdict.

  TIMING — the lookup starts IMMEDIATELY, here in <head>. It used to be started
  inside the DOMContentLoaded handler, which on a heavy storefront does not fire
  until ~7s; the 4s failsafe then gave up and revealed the store before the
  verdict had even been requested. The lookup needs no DOM, so it now fires at
  ~0ms and the verdict is normally in hand within a few hundred ms — long before
  any failsafe.

  FAIL OPEN: if ALL providers fail we cannot prove the visitor is in a blocked
  country, so the store shows as usual. Flip SHOW_STORE_IF_UNKNOWN to false to
  fail closed instead (unknown -> adjusted homepage). Do NOT trust Liquid's
  country: it defaults to the store's primary market and is unreliable.

  ANTI-FLICKER — WHITE HOLDING SCREEN: an html::before pseudo-element painted by
  an injected stylesheet. Not a JS-inserted <div> (loses the race with the
  parser), not visibility:hidden on <body> (visibility is inherited, so sticky
  headers and app blocks that set visibility:visible paint straight through it),
  and not toggled by a class on <html> (themes reassign className wholesale and
  silently wipe it). The style element's PRESENCE is the hold; removing it
  reveals. It sits on top of the store rather than hiding it, so layout and JS
  init are untouched and quick-add / UpCart still measure correctly.

  FAILSAFE: after FAILSAFE_MS with no verdict the page is revealed so it is never
  left white. It only fires while the verdict is genuinely outstanding — a
  blocked verdict that is waiting on the DOM does NOT trip it, and a blocked
  verdict arriving after it still applies the adjusted homepage.
{%- endcomment -%}
<script>
  window.isHomePage = {{ request.page_type | json }} === 'index';

  // --- Config ---------------------------------------------------------------
  // Countries that get the ADJUSTED homepage. Everyone else sees the store.
  var BLOCKED = ['PK', 'EG', 'MA', 'IL', 'LB', 'YE', 'OM', 'IN', 'GB'];

  // Country unknown (all geo providers failed) -> true shows the normal store.
  var SHOW_STORE_IF_UNKNOWN = true;

  // Paid Google Ads clicks always see the store, even from a blocked country.
  var PAID_ADS_BYPASS = true;

  // Cache the resolved country in localStorage for 24h?
  //   false = always do a live lookup (country always current, ~300ms per load)
  //   true  = returning visitors are gated instantly with no network call
  var USE_GEO_CACHE = false;

  var GEO_KEY             = 'geoCountry';
  var GEO_TTL_MS          = 24 * 60 * 60 * 1000; // re-check at most once per day
  var PROVIDER_TIMEOUT_MS = 5000;                // generous — providers run in PARALLEL
  var FAILSAFE_MS         = 6000;                // max white time while the verdict is outstanding
  var HOLD_STYLE_ID       = 'geoHoldStyle';

  var adsBypass     = false; // paid-ads hard stop: the gate must never close on a paid click
  var storeRevealed = false; // guards against double-reveal
  var verdictIn     = false; // true once the country is known (or known-unknown)

  // --- White holding screen --------------------------------------------------
  function holdPage() {
    if (document.getElementById(HOLD_STYLE_ID)) return;
    var s = document.createElement('style');
    s.id = HOLD_STYLE_ID;
    s.textContent =
      'html::before{' +
        'content:"" !important;' +
        'position:fixed !important;' +
        'top:0 !important;left:0 !important;right:0 !important;bottom:0 !important;' +
        'width:100% !important;height:100% !important;' +
        'background:#ffffff !important;' +
        'z-index:2147483647 !important;' +
        'pointer-events:auto !important;' +
      '}';
    (document.head || document.documentElement).appendChild(s);
  }

  function unhide() {
    var s = document.getElementById(HOLD_STYLE_ID);
    if (s && s.parentNode) s.parentNode.removeChild(s);
  }

  function revealStore() {
    if (storeRevealed) return;
    storeRevealed = true;
    unhide();
  }

  // Run fn now if the DOM is ready, otherwise as soon as it is.
  function onReady(fn) {
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fn);
    } else {
      fn();
    }
  }

  // Run fn as soon as #MaintenanceHome exists, WITHOUT waiting for
  // DOMContentLoaded. On a heavy storefront DCL can be 7s away, but the element
  // is parsed early in <body> — watching for it cuts the white hold from
  // seconds to milliseconds. Falls back to DOMContentLoaded either way.
  function whenMaintenanceExists(fn) {
    var ran = false;
    function go() {
      if (ran) return;
      ran = true;
      if (mo) { try { mo.disconnect(); } catch (e) {} }
      fn();
    }
    var mo = null;
    if (document.getElementById('MaintenanceHome')) { go(); return; }
    try {
      mo = new MutationObserver(function () {
        if (document.getElementById('MaintenanceHome')) go();
      });
      mo.observe(document.documentElement, { childList: true, subtree: true });
    } catch (e) {}
    onReady(go); // backstop: fire at DCL even if the element never appears
  }

  // --- Country helpers -------------------------------------------------------
  function getCachedCountry() {
    if (!USE_GEO_CACHE) return null;
    try {
      var o = JSON.parse(localStorage.getItem(GEO_KEY));
      if (o && o.cc && (Date.now() - o.ts) < GEO_TTL_MS) return o.cc;
    } catch (e) {}
    return null;
  }
  function setCachedCountry(cc) {
    if (!USE_GEO_CACHE) return;
    try { localStorage.setItem(GEO_KEY, JSON.stringify({ cc: cc, ts: Date.now() })); } catch (e) {}
  }
  function isBlockedCountry(cc) {
    if (!cc) return !SHOW_STORE_IF_UNKNOWN; // unknown country
    return BLOCKED.indexOf(cc) !== -1;
  }

  // --- Geo detection: parallel provider race ---------------------------------
  var GEO_PROVIDERS = [
    { url: 'https://api.country.is/',                 parse: function (d) { return d && d.country; } },
    { url: 'https://get.geojs.io/v1/ip/country.json', parse: function (d) { return d && d.country; } },
    { url: 'https://ipapi.co/json/',                  parse: function (d) { return d && d.country_code; } },
    { url: 'https://ipwho.is/',                       parse: function (d) { return d && d.success !== false && d.country_code; } }
  ];

  function fetchWithTimeout(url, ms) {
    var controller = new AbortController();
    var timer = setTimeout(function () { controller.abort(); }, ms);
    return fetch(url, { signal: controller.signal }).then(
      function (r) { clearTimeout(timer); return r; },
      function (e) { clearTimeout(timer); throw e; }
    );
  }

  // First provider to return a country code wins; '' only if all of them fail.
  function lookupCountry() {
    return new Promise(function (resolve) {
      var pending = GEO_PROVIDERS.length;
      var done = false;
      function finish(cc) {
        if (done) return;
        done = true;
        resolve(cc || '');
      }
      GEO_PROVIDERS.forEach(function (p) {
        fetchWithTimeout(p.url, PROVIDER_TIMEOUT_MS)
          .then(function (r) { return r.json(); })
          .then(function (d) { return p.parse(d); })
          .catch(function () { return null; })
          .then(function (cc) {
            if (cc) { finish(String(cc).toUpperCase()); return; }
            pending--;
            if (pending === 0) finish('');
          });
      });
    });
  }

  function detectCountryViaIP() {
    var cached = getCachedCountry();
    if (cached) return Promise.resolve(cached);
    return lookupCountry().then(function (cc) {
      if (cc) setCachedCountry(cc); // never cache a failed ''
      return cc;
    });
  }

  // --- Paid Google Ads bypass ------------------------------------------------
  // Google Ads appends a click-id on paid clicks: gclid (Search/Shopping),
  // gbraid / wbraid (iOS app/web), gad_source. Captured on ANY page and
  // persisted so a later homepage visit bypasses the IP gate.
  var PAID_ADS_KEY       = 'paidAdsVisit';
  var PAID_ADS_WINDOW_MS = 30 * 60 * 1000; // 30-minute attribution window

  function urlHasPaidAdsParam() {
    return /[?&](gclid|gbraid|wbraid|gad_source)=/i.test(window.location.search);
  }
  function hasPaidAdsVisit() {
    try {
      if (urlHasPaidAdsParam()) {
        localStorage.setItem(PAID_ADS_KEY, String(Date.now()));
        return true;
      }
      var ts = parseInt(localStorage.getItem(PAID_ADS_KEY), 10);
      if (ts && (Date.now() - ts) < PAID_ADS_WINDOW_MS) return true;
    } catch (e) {
      return urlHasPaidAdsParam();
    }
    return false;
  }

  // --- Adjusted homepage -----------------------------------------------------
  function forceFont(root) {
    if (!root) return;
    var font = 'system-ui, sans-serif';
    root.style.setProperty('font-family', font, 'important');
    root.querySelectorAll('*').forEach(function (node) {
      node.style.setProperty('font-family', font, 'important');
    });
  }

  // Styles the adjusted homepage FIRST and drops the holding screen LAST, so the
  // store is never visible for a single frame in between.
  function showMaintenance() {
    var maintenance = document.getElementById('MaintenanceHome');
    var baseCss     = document.getElementById('baseCss');
    if (maintenance) {
      maintenance.style.setProperty('display', 'block', 'important');
      maintenance.style.setProperty('visibility', 'visible', 'important');
      maintenance.style.setProperty('position', 'fixed', 'important');
      maintenance.style.setProperty('inset', '0', 'important');
      maintenance.style.setProperty('top', '0', 'important');
      maintenance.style.setProperty('left', '0', 'important');
      maintenance.style.setProperty('right', '0', 'important');
      maintenance.style.setProperty('bottom', '0', 'important');
      maintenance.style.setProperty('z-index', '2147483000', 'important');
      maintenance.style.setProperty('background', '#ffffff', 'important');
      maintenance.style.setProperty('overflow', 'auto', 'important');
    }
    document.documentElement.style.setProperty('overflow', 'hidden', 'important');
    if (document.body) document.body.style.setProperty('overflow', 'hidden', 'important');
    if (baseCss) baseCss.disabled = true;
    forceFont(maintenance);
    unhide();
  }

  // --- Main flow (runs NOW, in <head>) ---------------------------------------
  if (window.isHomePage) {
    holdPage();

    // Failsafe: only fires while the verdict is still outstanding. A blocked
    // verdict merely waiting on the DOM will not trip it.
    setTimeout(function () {
      if (verdictIn) return;
      if (SHOW_STORE_IF_UNKNOWN) { revealStore(); }
      else { whenMaintenanceExists(showMaintenance); }
    }, FAILSAFE_MS);

    if (PAID_ADS_BYPASS && hasPaidAdsVisit()) {
      adsBypass = true;
      verdictIn = true;
      revealStore();
    } else {
      // Start the lookup immediately — no DOM needed, no waiting for DCL.
      detectCountryViaIP().then(function (cc) {
        verdictIn = true;
        if (adsBypass) return;
        if (isBlockedCountry(cc)) {
          whenMaintenanceExists(showMaintenance); // hold stays up until the element is there
        } else {
          revealStore();            // allowed: reveal at once, don't wait for DCL
        }
      }).catch(function () {
        verdictIn = true;
        revealStore(); // never leave the page white on an unexpected error
      });
    }
  }

  // --- DOM-dependent housekeeping --------------------------------------------
  document.addEventListener('DOMContentLoaded', function () {
    var maintenance = document.getElementById('MaintenanceHome');

    // FIX (add-to-cart): UpCart's cart-drawer app block is rendered inside
    // #MaintenanceHome, which is display:none, so its drawer builds at 0x0 and
    // add-to-cart looks broken. Move any app block out to <body>.
    function relocateCartAppBlocks() {
      var mh = document.getElementById('MaintenanceHome');
      if (!mh) return;
      var blocks = mh.querySelectorAll('.shopify-app-block, [id^="shopify-block"]');
      for (var i = 0; i < blocks.length; i++) { document.body.appendChild(blocks[i]); }
    }
    relocateCartAppBlocks();
    setTimeout(relocateCartAppBlocks, 500);
    setTimeout(relocateCartAppBlocks, 1500);
    try {
      if (maintenance && window.MutationObserver) {
        new MutationObserver(relocateCartAppBlocks).observe(maintenance, { childList: true });
      }
    } catch (e) {}

    // Safety net: arm homepage quick-add buttons left in Impulse's
    // "--not-ready" state. Idempotent and harmless if already armed.
    function armQuickShop() {
      if (!window.theme || typeof theme.preloadProductModal !== 'function') return;
      document.querySelectorAll('.grid-product__has-quick-shop').forEach(function (item) {
        var btn = item.querySelector('.quick-product__btn--not-ready');
        if (!btn) return;
        var handle = item.getAttribute('data-product-handle');
        var id     = item.getAttribute('data-product-id');
        if (handle && id) {
          try { theme.preloadProductModal(handle, id, btn); } catch (e) {}
        }
      });
    }
    armQuickShop();
  });
</script>